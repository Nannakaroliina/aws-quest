# Normalise line endings on checkin; check out native.
* text=auto eol=lf

*.js     text eol=lf
*.mjs    text eol=lf
*.ts     text eol=lf
*.svelte text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Binary assets — never diff or normalise.
*.mp3 binary
*.png binary
*.jpg binary
*.woff2 binary

# Keep generated files out of diffs and language stats.
package-lock.json -diff linguist-generated
